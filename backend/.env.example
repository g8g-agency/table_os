# Security Secrets (min 16 chars)
QR_SIGNING_SECRET=development_qr_signing_secret_123
QR_SESSION_SECRET=development_qr_session_secret_123
DEVICE_TOKEN_SECRET=development_device_token_secret_123
RUNTIME_JWT_SECRET=development_runtime_jwt_secret_123
