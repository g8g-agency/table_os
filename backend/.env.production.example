NODE_ENV=production
PORT=3001

# Supabase (Production)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_production_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_production_service_role_key
SUPABASE_JWT_SECRET=your_production_jwt_secret

# App
ADMIN_FRONTEND_URL=https://admin.demo.domain.com
CORS_ORIGINS=https://menu.demo.domain.com,https://kds.demo.domain.com,https://admin.demo.domain.com

# Security Secrets (MUST BE SECURE AND RANDOM IN PRODUCTION)
QR_SIGNING_SECRET=change_me_in_production_min_16_chars
QR_SESSION_SECRET=change_me_in_production_min_16_chars
DEVICE_TOKEN_SECRET=change_me_in_production_min_16_chars
RUNTIME_JWT_SECRET=change_me_in_production_min_16_chars
